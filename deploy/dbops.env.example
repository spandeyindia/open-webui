# Copy to deploy/dbops.env, set mode 600, and set production values.
DBOPS_HOST=127.0.0.1
DBOPS_PORT=8080
DBOPS_DATA_DIR=/opt/dbops/data
DBOPS_RUNTIME_DIR=/opt/dbops/data/runtime
DATABASE_URL=sqlite:////opt/dbops/data/webui.db
WEBUI_SECRET_KEY=replace-with-a-long-random-secret
OFFLINE_MODE=true

# Keep Oracle 23ai details in the encrypted SQLite DbOps configuration.
# Do not put database passwords in this file.
